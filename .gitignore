# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Generated runtime and test downloads / caches
downloads/*.bin
downloads/*.part
downloads/*.bitmap.json
!downloads/.keep
**/downloads/*.bin
**/downloads/*.part
**/downloads/*.bitmap.json

edge_cache_store/
**/edge_cache_store/*
!**/edge_cache_store/.keep

# Generated test/simulation outputs
results/simulation_results.json
**/results/simulation_results.json

# Large generated demo files (can be auto-generated by running server.py)
updates/*.bin
!updates/.keep
**/updates/*.bin
!**/updates/.keep

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
